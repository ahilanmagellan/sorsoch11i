# Публичные данные проекта Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service Role ключ (Project Settings -> API -> service_role).
# ВАЖНО: никогда не отправлять в браузер, используется только на сервере.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Пароль для входа в /admin
ADMIN_PASSWORD=change-me

# Случайная строка для подписи сессионных JWT админки (например: openssl rand -hex 32)
ADMIN_JWT_SECRET=change-me-too
