# Публичные данные проекта Supabase (Project Settings -> API -> Publishable and secret API keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Secret ключ (Project Settings -> API -> Publishable and secret API keys -> secret).
# ВАЖНО: никогда не отправлять в браузер, используется только на сервере.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Пароль для входа в /admin
ADMIN_PASSWORD=change-me

# Случайная строка для подписи сессионных JWT админки (например: openssl rand -hex 32)
ADMIN_JWT_SECRET=change-me-too
